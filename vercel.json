{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/agents/cron/follow-ups",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/agents/cron/daily-brief",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/agents/cron/weekly-report",
      "schedule": "0 1 * * 1"
    },
    {
      "path": "/api/agents/cron/morning-brief",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/agents/cron/evening-report",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/agents/cron/command-digest",
      "schedule": "*/30 * * * *"
    },
    {
      "path": "/api/agents/cron/command-week",
      "schedule": "0 11 * * 0"
    }
  ]
}
