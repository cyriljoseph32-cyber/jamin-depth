# Public canonical/OG base URL. Optional — defaults to the deployed origin.
# Set this to your production domain once known (e.g. https://jamin-depth.vercel.app).
NEXT_PUBLIC_SITE_URL=https://jamin-depth.vercel.app

# On-site AI assistant (server-side only — NEVER prefix with NEXT_PUBLIC).
# Required for the chat widget to work. Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# Optional: override the assistant model (defaults to Claude Haiku 4.5).
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ─────────────────────────────────────────────────────────────────────────────
# Agent system (server-side only — never prefix any of these with NEXT_PUBLIC).
#
# Everything below is optional: each adapter falls back to an in-memory mock and
# reports itself as missing. A deployment never fails because a key is absent —
# it just does less. See docs/agents/DEPLOY.md for where to find each value.
# ─────────────────────────────────────────────────────────────────────────────

# Persistence. Without these, leads and the approval queue vanish on redeploy.
# Supabase → Project Settings → API. Run supabase/schema.sql once first.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# WhatsApp Cloud API (Meta). The app secret signs incoming webhooks — without it
# the endpoint is unauthenticated and anyone can impersonate a customer.
WHATSAPP_TOKEN=EAAG...
WHATSAPP_PHONE_NUMBER_ID=123456789012345
WHATSAPP_APP_SECRET=your_meta_app_secret
# You choose this string; paste the same one into the Meta webhook form.
WHATSAPP_VERIFY_TOKEN=choose_a_long_random_string

# Telegram — where the approval cards arrive and where you tap Approve/Reject.
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
TELEGRAM_CHAT_ID=123456789
# Chats allowed to DECIDE (comma-separated). Defaults to TELEGRAM_CHAT_ID.
TELEGRAM_ALLOWED_CHAT_IDS=123456789
# You choose this string; pass it to setWebhook as secret_token.
TELEGRAM_WEBHOOK_SECRET=choose_another_long_random_string

# Vercel Cron. Without it the scheduled endpoints stay closed (401).
CRON_SECRET=choose_a_third_long_random_string
